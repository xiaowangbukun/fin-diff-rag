# ==========================================================
# 复制为 .env 后按需修改（后端启动时会自动读取同目录 .env）
# 数据库只支持 PostgreSQL + pgvector（#21 起 SQLite 降级链路已移除），
# DATABASE_URL 必填；LLM Key 不配置 → 抽取式回答（权限/检索/审计照常）；
# EMBED_API_KEY 生产必填，不配置默认拒绝启动（方案 B），见下
# ==========================================================

# ---------- 数据库 ----------
# #21 起只支持 PostgreSQL + pgvector：DATABASE_URL 必填，缺失或非 postgres
# 开头会在启动期拒绝（config.require_database_url），不再回退 SQLite。
# 口令中的特殊字符必须 URL 编码：示例口令 Fin@Rag2026 含 @，不编码会被
# psycopg 当成 host 的一部分（解析成 Nul8280@127.0.0.1，报无法解析主机），
# 编码后为 Nzg%40Nul8280：
# DATABASE_URL=postgresql+psycopg://finrag:Nzg%40Nul8280@127.0.0.1:5432/finrag
DATABASE_URL=

# pgvector 列维度，必须与 EMBED_MODEL 输出维度一致；改动后需重建 chunks 表
EMBED_DIM=1024

# ---------- 大模型（OpenAI 兼容协议）----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- Embedding ----------
# 不填则复用 LLM_BASE_URL / LLM_API_KEY
EMBED_BASE_URL=
# 生产必填。#21 起本地哈希向量通道已移除，未配置 EMBED_API_KEY 时默认
# 拒绝启动（方案 B）——没有"无 Key 降级"这条路，避免看似正常实则无依据的答案。
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# true = 未配置 EMBED_API_KEY 时拒绝启动（默认，方案 B）。
# false = 显式放行，仅限离线测试/回归基线（tests/conftest.py 即如此）；
# 生产环境禁止置 false——那等于把无语义维度的检索结果当依据。
# EMBED_REQUIRE_API_KEY=false

# ---------- 安全 ----------
# JWT 密钥：留空时启动自动生成进程级随机密钥（重启后失效需重新登录），
# 绝不会退回固定默认值——忘配的最坏结果是不可用，而不是身份可被伪造。
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
# 生产必须显式注入 32 字节以上随机串；多 worker 部署尤其必须（随机密钥不跨进程，
# 症状是间歇性 401 且查不出原因）。配没配可看 GET /api/health 的 jwt_secret 字段
# （configured / ephemeral）。
JWT_SECRET=
# 轮换过渡：换密钥时先把旧值配到这里（只验证不签发），再换 JWT_SECRET，实现无缝轮换
JWT_SECRET_OLD=
# true = 未配置 JWT_SECRET 时拒绝启动（生产建议开启）
ENFORCE_JWT_SECRET=false
# 出厂口令闸门：种子数据注入的 admin/Admin@123 与业务角色 User@123 若未改，
# 等于把全库对内网开放（admin 为绝密级）。默认 false = 启动时打 [SECURITY]
# 告警但不拦（演示与冒烟链要用这些账号登录）；生产建议置 true：检出即拒绝启动。
ENFORCE_PASSWORD_CHANGE=false
JWT_EXPIRE_HOURS=12
# JWT 载荷只带 sub/username，不含密级/角色等权限声明——每次请求回库取最新态，
# 人员异动（降密/调岗/停用）立即生效，从设计上消除权限缓存时间窗。
# 部门树缓存仅作性能优化，TTL 秒级过期，结构变更立即失效：
DEPT_CACHE_TTL=5

# ---- 登录防爆破（P-11：按 key 失败计数 + 锁定）----
# pbkdf2 60 万迭代只能压慢爆破，不能阻止——计数+锁定把"无限试"变成"试 5 次等 15 分钟"。
# 后端选择：auto（默认，有 DATABASE_URL 就用共享 PG 表 login_attempts）/ memory
# （进程内，单 worker 或离线诊断）/ db（强制共享）。db 后端不可用时单次自动
# 回落 memory 并 30 秒后重试，登录入口不因计数存储故障整体不可用。
LOGIN_THROTTLE_BACKEND=auto
LOGIN_MAX_FAILS=5            # 窗口内失败次数上限，达到即锁定
LOGIN_WINDOW_MINUTES=5       # 失败计数的滚动窗口（分钟）
LOGIN_LOCK_MINUTES=15        # 触发锁定后的时长（分钟），到期自动解锁、管理员不可提前解

# ---- 输入质量上限（#9：边界拒绝，替代库层 500 与静默截断）----
# 超限请求在 schema/ingest 卡口处明确拒绝（422/400/413），不静默截断、不带进库层。
MAX_UPLOAD_MB=20             # 单上传文件字节上限（MB），超限 413
MAX_DOC_CHARS=500000         # 单文档正文字符上限，超限 400
MAX_QUERY_CHARS=1000         # 单轮问答 query 字符上限，超限 400

# ---- 原件留存（MinIO / S3 兼容；默认关闭）----
# 关闭（默认）= 上传原文解析完即删，库内只有切片文本（隐私最小化）。
# 开启 = 原始字节另存对象存储，供人工审查"当时提交的是什么"；审查接口在
# /api/admin/documents/{doc_id}/original（meta / 下载 / verify），仅管理员且受密级闸门约束。
# 注意：自建 S3 的删除是逻辑删除 + 后台清扫，**不等于 WORM**；要不可篡改的
# 合规留存需另开对象锁（Object Lock）+ 版本化并独立运维。
ORIGINAL_STORE_ENABLED=false
ORIGINAL_STORE_ENDPOINT=             # 例：127.0.0.1:9000（内网 MinIO）
ORIGINAL_STORE_BUCKET=finrag-originals
ORIGINAL_STORE_PREFIX=originals
ORIGINAL_STORE_REGION=us-east-1
ORIGINAL_STORE_SECURE=false          # true = HTTPS；明文只允许本机测试
ORIGINAL_STORE_ACCESS_KEY=           # 建议走托管源（SECRETS_PROVIDER）
ORIGINAL_STORE_SECRET_KEY=
# 严格模式：原件写不进去就拒绝入库（首次上传回滚整次入库）。默认宽容：
# 文档照常入库，但响应 original.stored=false、审计记 flag。
ORIGINAL_STORE_STRICT=false
ORIGINAL_STORE_GET_MAX_MB=32         # 审查端单次取回上限，防止大对象打满内存

# ---------- 意图识别网关（前置意图分类）----------
# safe 正常查询放行 / risky 跨域组合→推理距离约束（仅单一文档作答）/ danger 拼图探针→物理阻断
INTENT_ENABLED=true
INTENT_LEDGER_TRIGGER=4   # 窗口内同文档窄问次数达到该值 → 记探针指纹（升级为 Risky）
# 探针锚句相似度（P0-3）：query 与典型诱导表述的余弦相似度，复用 embedding 通道，
# 补正则对同义改写/全角/零宽/中英混杂的盲区。低于阈值不扣分。
# API/无服务两套阈值按运行时模式切换；生产因 #21 方案 B 必配 EMBED_API_KEY，
# LOCAL 分支实际只可能在离线测试（EMBED_REQUIRE_API_KEY=false）下走到。
INTENT_ANCHOR_ENABLED=true
INTENT_ANCHOR_THRESHOLD_API=0.80    # 远程 embedding 模式阈值
INTENT_ANCHOR_THRESHOLD_LOCAL=0.62  # 无 embedding 服务模式阈值（区分度有限，宁低勿高）
INTENT_ANCHOR_SCORE_API=2           # API 模式命中计分（等同强特征 → Danger）
INTENT_ANCHOR_SCORE_LOCAL=1         # 无 embedding 服务模式命中计分（只到 Risky，防误杀）
# INTENT_ANCHORS=   # JSON 数组覆盖默认锚句集，按实际攻击样本热更新

# ---------- 第二因子（TOTP）与企业单点登录（OIDC）----------
# 两条路径可同时启用：本地账号走「口令 + TOTP」，企业账号走「OIDC 授权码 + PKCE」。
# MFA_ENABLED=true 只代表"允许绑定"；是否强制由下面两项决定：
MFA_ENABLED=true
MFA_ENFORCE_ADMIN=false     # 生产建议 true（admin 可见绝密）
MFA_ENFORCE_ALL=false
TOTP_ISSUER=FinRAG
TOTP_DIGITS=6
TOTP_PERIOD=30
TOTP_WINDOW_STEPS=1         # ±1 个时间步（30 秒）漂移容忍，再宽就是给爆破让路
# 密钥静态加密材料（Fernet key，64 字符 urlsafe base64）。
# 留空 = 由 JWT_SECRET 派生；轮换 JWT_SECRET 会让已绑定密钥解不开，生产请独立配置。
MFA_SECRET_KEY=

# 一次性恢复码（手机丢失/换机自助登录）：绑定时发放个数，服务端只存摘要、一码一用。
# RECOVERY_CODE_ENABLED=false 可应急关闭整条通道（存量码立即失效）。
RECOVERY_CODE_ENABLED=true
RECOVERY_CODE_COUNT=10

# OIDC：开启时必须配齐 ISSUER 与 CLIENT_ID，否则拒绝启动。
# 回调地址在 IdP 侧登记为 {站点}/api/auth/oidc/callback（也可用 OIDC_REDIRECT_URI 显式指定）。
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
# 默认"先建号后认证"；true = 首登按 IdP 身份自动建号（默认密级/角色见下，无本地口令）
OIDC_JIT_PROVISION=false
OIDC_DEFAULT_CLEARANCE=0
OIDC_DEFAULT_ROLES=
# IdP 已完成 MFA（条件访问/认证流程）时保持 true，本地不再叠加动态口令
OIDC_TRUST_IDP_MFA=true
OIDC_METADATA_TTL=3600      # discovery/JWKS 进程内缓存秒数
OIDC_HTTP_TIMEOUT=10
OIDC_BUTTON_LABEL=企业单点登录

# ---- IdP claim → 本地权限同步（默认关）----
# 默认关是有意的：IdP 侧一次误配置就能放大数据可见面，权限应以本地为准。
# 开启后只认白名单映射；claim 里没登记的值按 OIDC_CLAIM_SYNC_UNKNOWN 处理。
OIDC_CLAIM_SYNC=false
OIDC_ROLE_CLAIM=roles
# IdP 角色名:本地角色名，逗号分隔，例如 "fin_research:research,fin_risk:risk"
OIDC_ROLE_MAP=
# 密级 claim（留空 = 不同步密级）；映射写在 OIDC_CLEARANCE_MAP
OIDC_CLEARANCE_CLAIM=
# 例如 "public:0,internal:1,confidential:2,secret:3"
OIDC_CLEARANCE_MAP=
# claim 同步能授予的密级上限（默认 1=内部）：IdP 配了 secret 也不会自动抬到绝密，
# 绝密必须由本地管理员显式授予。
OIDC_CLAIM_SYNC_MAX_CLEARANCE=1
# 是否允许 claim 同步授予 admin（默认否：管理员必须是本地显式操作）
OIDC_CLAIM_SYNC_ALLOW_ADMIN=false
# 白名单外的角色/密级值：ignore（忽略，保持本地现状）/ deny（拒绝本次登录）
OIDC_CLAIM_SYNC_UNKNOWN=ignore
# 密级撤权口径（角色同步不受此开关影响）：
#   union（默认）= 只升不降：claim 只能把密级往上抬，撤权必须走本地双人复核；
#   authoritative = 允许 IdP 撤权：IdP 调低密级时只回落到**同步前的本地基线**，
#     本地管理员另行授予的更高密级不会被抹掉。溯源列见 0002 迁移。
# 适合"入转调离由 IdP 驱动、离岗即收权"的机构；需要 IdP 侧数据准确且有审计。
OIDC_CLAIM_SYNC_MODE=union

# ---------- 审计防篡改（P0-2）----------
# 每行审计计算 sha256 链式哈希 + 单调序号 + 启动锚点（data/audit_anchor.json）。
# 管理端 GET /api/admin/audit/verify 校验完整性（仅管理员）。
# 注意：多 worker 部署时链会分叉，生产请单 worker 运行或用 PG advisory lock（见 README）。

# ---- 审计锚点外置（防"库写 + 应用磁盘写"双权限重算全链）----
# 本地锚点文件与库同生共灭：同时拿到库写权限与磁盘写权限的人可以整体重写链并
# 同步改锚点。把链尾再追加一份到应用不可回写的位置，才能独立比对。
# 二选一（都配则两路都写）：只追加文件（如 WORM 挂载/日志卷）或 POST 日志网关。
# 记录只用 HMAC-SHA256 签名（默认由 JWT_SECRET 派生密钥，也可独立配置）。
# **生产必须配独立密钥**：沿用 JWT_SECRET 时，JWT 轮换或空密钥随机化会让历史
# 外置记录全部验签失败——巡检看到的 bad_signature 激增是"密钥换了"，不是"有人
# 伪造锚点"。记录里带 key_id（密钥指纹前 12 位），脚本据此把这类记录单列为
# stale_key，只有"指纹相同却验签不过"才算可疑。
AUDIT_ANCHOR_EXTERNAL_FILE=
# 例：https://siem.internal/ingest/audit-anchor（POST JSON，5 秒超时）
AUDIT_ANCHOR_URL=
AUDIT_ANCHOR_HMAC_KEY=
AUDIT_ANCHOR_INTERVAL_SECONDS=60   # 链尾外发限频；管理员 POST /audit/anchor 可强制打点
AUDIT_ANCHOR_TIMEOUT=5

# ---- 审计行全量外送（P0-3）----
# 锚点只回答"尾行有没有被改/被删"；行副本回答"中间发生过什么"。
# 每批新增审计行（seq + row_hash + action/decision/user/ip，**不含 query 正文**）
# 与链尾锚点写进同一个只追加流（kind=audit_rows / kind=audit_anchor）。
AUDIT_SHIP_ROWS=true
# 审计表只追加：DB 触发器拒绝 UPDATE/DELETE/TRUNCATE（演练破窗见 docs/BACKUP-RESTORE.md）
AUDIT_APPEND_ONLY=true

# ---------- 部署边界（P0-2）----------
# 反代终止 TLS 时应用看到的是 http：只有信任转发头时才认可 X-Forwarded-Proto。
TRUST_PROXY_HEADERS=false
# true = 明文请求 308 跳 https（健康探针豁免，避免 LB 误判不健康）
FORCE_HTTPS=false
HSTS_SECONDS=31536000        # 仅在 HTTPS 上发；0 = 不发
SECURITY_HEADERS=true        # 统一补 nosniff / X-Frame-Options / Referrer-Policy / CSP
# CSP 默认按"前端同源托管"写；Element Plus 有运行时内联样式，故 style-src 留 unsafe-inline
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
# 跨域白名单（逗号分隔，默认空 = 只允许同源）。前端口令/CSRF 头都依赖它。
CORS_ALLOW_ORIGINS=
# Host 头白名单（逗号分隔，默认空 = 不校验）；防 DNS rebinding
TRUSTED_HOSTS=
# true = 关闭 /docs /redoc /openapi.json（生产建议开启）
DISABLE_DOCS=false

# ---------- 会话生命周期（P0-4）----------
SESSION_IDLE_MINUTES=30      # 空闲超时（服务端判定，0=关闭）；到期即吊销会话
SESSION_TOUCH_SECONDS=60     # last_seen_at 回写节流，避免每请求一次 UPDATE
# true = 令牌只走 HttpOnly Cookie + CSRF 双提交（金融机构推荐，JS 读不到令牌）
AUTH_COOKIE_MODE=false
AUTH_COOKIE_NAME=finrag_session
CSRF_COOKIE_NAME=finrag_csrf
# auto = 按请求协议判定（https 才加 Secure）；也可显式 true/false
AUTH_COOKIE_SECURE=auto

# ---------- 密钥托管（P0-5）----------
# auto = 配了 SECRETS_DIR 用 file，配了 SECRETS_URL 用 http，都没有则用 .env
# 托管源一旦启用，**不再回落 .env**（避免"以为在托管、实际在用明文"）
SECRETS_PROVIDER=auto
# file：密封卷目录，按文件名读取（JWT_SECRET / jwt-secret / jwt_secret 均可）
SECRETS_DIR=
# http：GET {SECRETS_URL}/v1/secret/{name}，兼容 {"value"} 与 Vault KV v2
SECRETS_URL=
SECRETS_TOKEN=
SECRETS_TTL=300
SECRETS_TIMEOUT=5
# true = 启动期强制校验密钥确由托管源提供（缺则拒绝启动，生产建议开启）
REQUIRE_SECRETS_PROVIDER=false
# true = DATABASE_URL 必须显式 sslmode=require/verify-ca/verify-full（prefer 不算）
REQUIRE_DB_TLS=false

# ---------- Fail-Secure 容灾降级 ----------
# 权限/检索组件异常时：切断内部知识库，降级为仅检索 Public 公开域；
# 公开域也不可用 → 安全拒答。宁可答非所问或保持沉默，绝不越权一个字。
FAIL_SECURE_ENABLED=true

# ---------- 提示注入防护（P1-4）----------
# 检索资料视为数据而非指令：入库与问答出口双向扫描"忽略规则/输出提示词"类话术。
# 命中只标记留痕（上传审计 decision=flag / 问答响应 inject_flag=true），默认不拦截，
# 避免正则误伤正常业务文本；true = 问答出口检出注入时直接用安全拒答替换回答。
INJECT_BLOCK_OUTPUT=false

# ---------- 敏感信息识别扩展（P1-5）----------
# 自定义 PII 正则（JSON 数组），启动时追加到识别规则尾部，解析失败只告警不阻断。
# JSON 里反斜杠必须双写（\\d 而非 \d）；自定义规则不走银行卡上下文逻辑：
# PII_EXTRA_PATTERNS=["工号\\d{6}", {"kind":"合同编号","pattern":"HT-\\d{10}"}]
# PII_EXTRA_PATTERNS=
# 可选 NER 兜底（OpenAI 兼容 chat 协议）：正则未命中时才调用，3s 超时、失败静默，
# 任何异常都不影响主链路——NER 只是正则的补充。留空 = 关闭：
# PII_NER_URL=https://your-ner-endpoint/v1

# ---------- 审计异步写入（P1-8）----------
# 请求线程只入队，后台守护线程批量落库（AUDIT_BATCH_MAX 行 / AUDIT_BATCH_TIMEOUT 一批，
# 独立 Session 单事务提交）；队列满自动回落同步直写，审计不丢；关停时自动 flush 收尾。
# 注意：仍要求单 worker 部署（多 worker 会分叉哈希链，同 P0-2 约束）。
AUDIT_QUEUE_MAXSIZE=10000
AUDIT_BATCH_MAX=50
AUDIT_BATCH_TIMEOUT=0.2

# ---------- 检索参数 ----------
TOP_K=8
CANDIDATE_POOL=60
MAX_CONTEXT_CHARS=6000

# ---------- 切片 ----------
CHUNK_SIZE=520
CHUNK_OVERLAP=80

# ---------- 防拼图攻击（累积暴露管控）----------
# 单次请求永远合法，只有跨会话累积才暴露意图，故按"已披露比例"裁决。
# JIGSAW_ENABLED=false 可整体关闭（仅建议联调时使用）
JIGSAW_ENABLED=true
JIGSAW_WINDOW_HOURS=24        # 记账滚动窗口（小时）
JIGSAW_DOC_COVER_WARN=0.45    # 单文档覆盖率软阈值 → 每轮只给 1 段新内容
JIGSAW_DOC_COVER_STOP=0.70    # 单文档覆盖率硬阈值 → 停止供给该文档新切片
JIGSAW_MIN_DOC_CHUNKS=6       # 低于此段数的文档不启用覆盖率闸（短文档无拼图价值）
JIGSAW_MAX_CHUNKS_PER_DOC=12  # 单用户单文档窗口内切片配额
JIGSAW_MAX_PER_TURN=2         # 单轮单文档新切片交付上限（防"一轮搬空"）
JIGSAW_USER_DOC_LIMIT=25      # 窗口内可触及文档数
JIGSAW_USER_CHAR_LIMIT=120000 # 窗口内累计披露字符数
JIGSAW_FULLREAD_LIMIT=3       # 窗口内全篇直读次数上限
JIGSAW_RECALL_FACTOR=3        # 召回放大倍数，抵消限流占用的名额（避免误伤正常问答）
# JIGSAW_ADMIN_EXEMPT=true 时管理员不受限（默认 false，安全岗也要记账）
JIGSAW_ADMIN_EXEMPT=false

# ---- 慢速拼图：长周期累计闸（P1-7）----
# 短窗口滚过去就清零，每天卡在阈值 90% 慢拉照样能长期搬空语料，故按近 N 日累计裁决。
JIGSAW_LONG_WINDOW_DAYS=7         # 长周期统计跨度（天）
JIGSAW_LONG_USER_CHAR=60000       # 近 N 日用户累计披露字符 → 暂停应答
JIGSAW_LONG_DOC_CHAR=25000        # 近 N 日单文档累计披露字符 → 该文档停机
# 用户风险分：触发 block 或单文档停机阈值 +1，每满 30 天惰性衰减 1。
# 有效分达到该值 → 该账号转人工审核（POST /api/admin/users/{id}/reset-risk 复位）
JIGSAW_RISK_READONLY=3

# ---- 跨账号合谋拼图：检出（不拦截）----
# 单账号账本挡不住 "N 个低权限账号各取一块、线下合并"。这里按长窗口聚合
# 多账号对同一文档的已见切片并集，并集覆盖率超线即在
# GET /api/admin/jigsaw/coalition 列出（成员/条数/字符数）。
# 只做检出、不自动处置：热门文档被同事正常阅读时并集天然很高，自动封禁会误伤业务。
JIGSAW_COALITION_ENABLED=true
JIGSAW_COALITION_MIN_USERS=3     # 至少几个账号参与才计入
JIGSAW_COALITION_COVER=0.85      # 并集覆盖率报警线（0.85 = 85%）

# ---- 向量索引（P1-6，仅 PostgreSQL/pgvector 生效）----
HNSW_AUTO_BUILD_MAX=50000   # chunks 行数超过则启动时不再自动建索引，需低峰跑：python run.py build-index
HNSW_EF_SEARCH=100          # 查询期 ef_search，越大召回越准、越慢

# ---- 密级变更审批流（P2-9）----
# 降密 = 把受限内容开放出去，不可逆，必须他人复核（申请人不能自批、拒绝要写理由、
# 审批人密级不得低于目标密级）；升密（变严）不产生外流，默认直接生效。
APPROVAL_UPGRADE_REQUIRED=false
# 紧急旁路（break-glass）：开启后降密免审批，仅事故处置时临时开，用完必须关回去。
APPROVAL_EMERGENCY_BYPASS=false

# ---- 运维监控日报（P2-12）----
# GET /api/admin/report/daily?date=YYYY-MM-DD（留空=今天，UTC 自然日），仅管理员。
# 纯只读聚合：日报自身不写审计，避免污染当天风险计数与哈希链。
REPORT_TOP_N=5              # Top 榜单长度（触发最多的账号 / 被访问最多的文档 / 动作分布）
REPORT_INCLUDE_TEXT=true    # false = 接口只返回结构化 dict，不附带可读文本日报

# ---- 安全指标监控（P2-12，设计文档口径；与上面的单日日报并存、互不替代）----
# GET /api/admin/metrics?days=14：按天时序 + 拦截率异常判定 + markdown 落盘 + webhook 告警。
# 默认关闭；关闭时接口返回 503（并提示启用方式），不落盘、不推送。
METRICS_ENABLED=false
# 当日拦截率（blocked / 当日审计总量）超过该阈值 → 记入 alerts 并推送告警：
ALERT_BLOCK_RATE=0.30
# 参与判定的最小样本量：当日审计总量不足该值的日期不参与异常判定
# （避免"今天只有 1 条请求且被拦 → 拦截率 1.0 → 误报"）：
ALERT_MIN_ACTIONS=20
# 异常日摘要推送地址（POST JSON，标准库 urllib，5s 超时）。留空 = 不推送；
# 推送失败只记 warning，不影响接口返回：
# ALERT_WEBHOOK_URL=https://your-alert-endpoint/hook
